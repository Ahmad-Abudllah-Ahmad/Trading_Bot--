# Autonomous Trading System — Environment Variables
# Copy this as .env and fill in your API keys
# DO NOT commit .env to git — it contains secrets

# ── LLM Providers (required) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Market Data (free — get FRED key at fred.stlouisfed.org) ─────────────────
FRED_API_KEY=

# ── Broker — Alpaca (free paper + live, app.alpaca.markets) ──────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true        # set to false ONLY after successful paper trading

# ── Notifications — Telegram (optional but recommended) ─────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Start chat with your bot, then open:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    and copy the "id" from the "chat" object
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── TradingAgents overrides (optional — runner.py sets these in code) ─────────
# TRADINGAGENTS_LLM_PROVIDER=openai
# TRADINGAGENTS_QUICK_THINK_LLM=gpt-4o-mini
# TRADINGAGENTS_DEEP_THINK_PROVIDER=anthropic
# TRADINGAGENTS_DEEP_THINK_LLM=claude-sonnet-4-5
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=2
# TRADINGAGENTS_MAX_RISK_ROUNDS=1

# ── SEC EDGAR (no key needed, but set your contact info) ─────────────────────
SEC_EDGAR_USER_AGENT=YourName your@email.com

